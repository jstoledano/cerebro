# ─────────────────────────────────────────────
# .env.container — Variables para el pod cerebro
# NO subir a git. Agregar a .gitignore.
# ─────────────────────────────────────────────

# Django
DJANGO_SETTINGS_MODULE=core.settings
SECRET_KEY=cambia-esto-por-una-clave-segura-de-50-chars
DEBUG=False
ALLOWED_HOSTS=172.19.17.22,localhost,127.0.0.1
SITE_URL=http://127.0.0.1:8000

# Base de datos
DB_NAME=cerebro
DB_USER=cerebro
DB_PASSWORD=cambia-esto-por-password-seguro
DB_HOST=db
DB_PORT=5432

# Media y static
MEDIA_ROOT=/app/media
STATIC_ROOT=/app/staticfiles
