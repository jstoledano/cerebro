;;; change-state.el --- Transition Org task with mandatory LOGBOOK note -*- lexical-binding: t; -*-
;; Usage: emacs --batch -Q --script change-state.el -- FILE ID STATE NOTE
(require 'org)
(require 'subr-x)

(defun agenda-change-state (filename task-id target note)
  (unless (and (member target '("TODO" "DONE")) (not (string-empty-p (string-trim note))))
    (error "Estado o nota invalida"))
  (with-current-buffer (find-file-noselect filename)
    (org-mode)
    (let ((found nil)
          (old nil)
          (org-log-done nil)
          (org-log-states nil)
          (org-log-into-drawer "LOGBOOK")
          (org-enforce-todo-dependencies nil))
      (org-map-entries
       (lambda ()
         (when (equal (org-entry-get (point) "ID") task-id)
           (when found (error "ID duplicado: %s" task-id))
           (setq found (point)))) nil 'file)
      (unless found (error "ID no encontrado: %s" task-id))
      (goto-char found)
      (setq old (org-get-todo-state))
      (unless (member old '("TODO" "DONE"))
        (error "Transicion no permitida desde %s" old))
      (when (equal old target) (error "La actividad ya tiene el estado solicitado"))
      (org-todo target)
      ;; Insertar entrada con la sintaxis LOGBOOK reconocida por Org.
      (org-back-to-heading t)
      (let* ((stamp (format-time-string "[%Y-%m-%d %a %H:%M]"))
             (lines (split-string (string-trim note) "\n" t))
             (entry (concat (format "- State \"%s\" from \"%s\" %s\n" target old stamp)
                            (mapconcat (lambda (line) (concat "  " (string-trim line))) lines "\n")
                            "\n")))
        (save-excursion
          (org-back-to-heading t)
          (let ((heading-end (save-excursion (outline-next-heading) (point))))
            (if (re-search-forward "^[ \t]*:LOGBOOK:[ \t]*$" heading-end t)
                (progn (forward-line 1) (insert entry))
              (org-back-to-heading t)
              (org-end-of-meta-data t)
              (insert ":LOGBOOK:\n" entry ":END:\n")))))
      (save-buffer)
      (princ (format "OK %s %s %s\n" task-id old target)))))

(condition-case err
    (let ((args (remove "--" command-line-args-left)))
      (unless (= (length args) 4) (error "Uso: FILE ID STATE NOTE"))
      (apply #'agenda-change-state args))
  (error (princ (format "ERROR: %s\n" (error-message-string err)))
         (kill-emacs 1)))
